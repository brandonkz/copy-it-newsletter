# Canonical origin for absolute URLs. No trailing slash.
# Optional on Vercel. If unset, the build uses https://$VERCEL_PROJECT_PRODUCTION_URL,
# then https://$VERCEL_URL. Set this to force a specific *.vercel.app hostname
# or a custom domain later. Changing it requires a new build.
SITE_URL=https://your-project.vercel.app

# Optional override for the Google tag (gtag.js). Not Google Tag Manager.
# Leave unset to use the default committed in site.config.js (G-WP1K1WK42Y).
# Set another G- ID to replace it, or set off to load no analytics tag.
# Read at build time. Redeploy after changing it.
# GA4_MEASUREMENT_ID=

# Runtime secret for api/subscribe. Never put this in client code or the repo.
BEEHIIV_API_KEY=

# Optional. Defaults to the Fitsorted publication
# pub_cec2d599-5490-49b5-bb78-7cd7a9831890 in site.config.js.
# BEEHIIV_PUBLICATION_ID=

# Set to true to send people to /thank-you after a successful signup.
# Default is inline success on the page. Read at request time, no rebuild needed.
REDIRECT_TO_THANK_YOU=false
